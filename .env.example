# Credentials for THIS deployment. Copy to .env and fill in.
# .env is gitignored; never commit it.
#
# The account must be able to read the curate list. An app password
# (Settings -> App Passwords) is enough - the service never posts, likes or
# follows: it only reads public records and the list.
BSKY_HANDLE=your-handle.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
